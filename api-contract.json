{
  "version": "1.0",
  "base": "/api/v1",
  "authentication": "production backend session/token; never embed credentials in frontend",
  "endpoints": [
    {
      "method": "GET",
      "path": "/health",
      "purpose": "backend readiness"
    },
    {
      "method": "GET",
      "path": "/me",
      "purpose": "customer profile"
    },
    {
      "method": "GET",
      "path": "/accounts",
      "purpose": "customer-visible accounts/listings"
    },
    {
      "method": "GET",
      "path": "/notifications",
      "purpose": "customer notifications"
    },
    {
      "method": "POST",
      "path": "/notifications/{id}/read",
      "purpose": "mark notification read"
    },
    {
      "method": "GET",
      "path": "/marketplace",
      "purpose": "marketplace discovery"
    },
    {
      "method": "POST",
      "path": "/verify",
      "purpose": "submit verification request"
    },
    {
      "method": "POST",
      "path": "/terminal/sessions",
      "purpose": "create or resume an authenticated user-scoped terminal session"
    },
    {
      "method": "POST",
      "path": "/terminal/sessions/{id}/commands",
      "purpose": "execute one command inside the authorized workspace"
    },
    {
      "method": "POST",
      "path": "/terminal/sessions/{id}/interrupt",
      "purpose": "interrupt the active command in the authorized session"
    }
  ],
  "excluded": [
    "API keys in browser",
    "password storage in frontend",
    "live trading/order execution"
  ]
}
